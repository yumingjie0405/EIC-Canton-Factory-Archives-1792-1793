# ============================================================
# 环境变量与密钥（严禁上传）
# ============================================================
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
secrets.*

# Prompt 工程成果（不公开）
backend/app/prompts/*.txt

# ============================================================
# 用户数据与运行时产物（storage 约 7GB，绝不上传）
# ============================================================
storage/uploads/*
storage/pages/*
storage/results/*
storage/exports/*
!storage/**/.gitkeep

# OCR / PPT 生成产物（可重新生成）
output/
outputs/

# 项目内部文档与工具脚本（不公开）
docs/
word/
*.xlsx
pdf_v2.py
generate_ppt.py
BUGFIX_*.md

# README 需要的资源保留
!assets/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python packaging output. Anchored with a leading slash so only the
# repository-root ``lib/`` is ignored: an unanchored ``lib/`` also matched
# ``frontend/src/lib/`` and silently hid the frontend source files from Git.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 测试与类型检查缓存
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/

# 数据库（本地 SQLite 等）
*.db
*.sqlite
*.sqlite3

# ============================================================
# Node.js / Next.js（前端）
# ============================================================
node_modules/
.next/
.next-*/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts
.pnp
.pnp.js

# 前端日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================
# 日志与临时文件
# ============================================================
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo

# ============================================================
# 操作系统
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================
# IDE / 编辑器
# ============================================================
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code 本地配置与上下文
.claude/

# ============================================================
# 其他
# ============================================================
*.doc~
~$*

backups/

# Application source libraries are not Python build output.
!frontend/src/lib/
!frontend/src/lib/*.ts

# Document-specific correction terms and annotation images stay local.
backend/config/correction_profiles.local.json
ocr_training/packages/
ocr_training/exports/

# Public deployment runtime secrets.
deploy/secrets/
deploy/.env

# ============================================================
# 本地临时产物与个人笔记（不入库）
# ============================================================
# scratch/: 调试脚本、运行日志（日志可能含 prompt 与请求片段）
# 个人文件/: 个人规划、验收报告、操作手册（含形似密钥的占位符）
scratch/
个人文件/

